# Which LLM API to use for extraction: "anthropic" or "openai"
# "openai" works with any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Gemini's OpenAI endpoint)
EXTRACT_PROVIDER=anthropic

# Model id for the chosen provider, e.g. claude-sonnet-5-5 or gpt-4.1
EXTRACT_MODEL=claude-sonnet-5-5

ANTHROPIC_API_KEY=

OPENAI_API_KEY=
# Optional, for OpenAI-compatible providers. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
