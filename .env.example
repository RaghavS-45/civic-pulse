# Used by the pipeline scripts (extract, translate, tts) AND by the live AI features on the site
# (Explain any notification, Ask a question). The rest of the site needs no key.

# Which LLM API to use: "anthropic" or "openai"
# "openai" works with any OpenAI-compatible endpoint (OpenAI, Gemini, Groq, OpenRouter)
EXTRACT_PROVIDER=openai

# One model, or several comma-separated: the next is tried when one is busy or out of quota
EXTRACT_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# For Gemini: your Google AI Studio key and its OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Only if EXTRACT_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional, for npm run tts: Gemini key (defaults to OPENAI_API_KEY), model and voice
GEMINI_API_KEY=
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
